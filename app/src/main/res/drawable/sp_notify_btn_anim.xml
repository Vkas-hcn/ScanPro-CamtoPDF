<?xml version="1.0" encoding="utf-8"?>
<!--
  通知按钮的呼吸动画。Apollo 用 `annotify_big_btn_anim` / `notify_small_btn_anim` 两个
  animated-image 指向外部图片；这里用一个 alpha 呼吸的 animated-vector 顶掉，形状自己画。
  两个版式共用同一份。

  注：RemoteViews 里的 ImageView 不一定自播 AVD（`autoStart` 是给本进程用的），最差情况
  停在第一帧——和 Apollo 的表现一致。
-->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:autoMirrored="true"
    android:drawable="@drawable/sp_notify_btn_shape">
    <target android:name="spNotifyBtnShape">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="900"
                android:propertyName="alpha"
                android:repeatCount="infinite"
                android:repeatMode="reverse"
                android:valueFrom="1.0"
                android:valueTo="0.45"
                android:valueType="floatType" />
        </aapt:attr>
    </target>
</animated-vector>
