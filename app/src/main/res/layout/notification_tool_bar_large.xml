<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:id="@+id/root"
    android:baselineAligned="false"
    android:gravity="center">

    <LinearLayout
        android:id="@+id/delete_cache"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="31dp"
            android:layout_height="31dp"
            android:layout_marginHorizontal="8dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_notify_bar_home" />

        <TextView
            android:id="@+id/tv_delete_cache"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:minLines="1"
            android:maxLines="1"
            android:textStyle="bold"
            android:textSize="11sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/delete_large"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">


        <ImageView
            android:layout_width="31dp"
            android:layout_height="31dp"
            android:layout_marginHorizontal="8dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_scan_small" />

        <TextView
            android:id="@+id/tv_delete_large"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:minLines="1"
            android:maxLines="1"
            android:textStyle="bold"
            android:textSize="11sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/delete_dup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">


        <ImageView
            android:layout_width="31dp"
            android:layout_height="31dp"
            android:layout_marginHorizontal="8dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_notify_bar_recent" />

        <TextView
            android:id="@+id/tv_delete_dup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:minLines="1"
            android:maxLines="1"
            android:textStyle="bold"
            android:textSize="11sp" />

    </LinearLayout>

</LinearLayout>