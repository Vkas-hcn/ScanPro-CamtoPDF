<?xml version="1.0" encoding="utf-8"?>
<!--
  系统通知的「小图」版式（横幅型）。出处：ApolloPDF `layout/sys_notification_small_view.xml`。
  `root` 是 29 以下补 padding 用的（代码里 `setViewPadding`）。
  正文色同上，由 `SpNotifyCreator` 用 `setTextColor` 按系统深浅色盖。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="65dp"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/messageText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="2"
        android:textColor="@color/sp_notify_text"
        android:textSize="16sp"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="5dp">

        <ImageView
            android:id="@+id/anim_btn"
            android:layout_width="75dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/btnText"
            android:layout_width="75dp"
            android:layout_height="34dp"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="@string/sp_notify_action"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />
    </FrameLayout>
</LinearLayout>
