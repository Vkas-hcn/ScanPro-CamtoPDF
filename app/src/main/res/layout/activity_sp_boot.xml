<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/boot_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg"
    tools:context=".boot.SpBootActivity">

    <LinearLayout
        android:id="@+id/boot_brand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.38">

        <ImageView
            android:id="@+id/iv_boot_logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/cam_boot_mark" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_boot_title_lead"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/boot_title_lead"
                android:textColor="#EE2729"
                android:textSize="@dimen/boot_title_size"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_boot_title_trail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/boot_title_trail"
                android:textColor="#1D0E0F"
                android:textSize="@dimen/boot_title_size"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/boot_progress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/splash_progress_margin_horizontal"
        android:layout_marginBottom="@dimen/boot_progress_margin_bottom"
        android:max="100"
        android:progress="0"
        android:indeterminate="false"
        app:indicatorColor="@color/cam_accent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:trackColor="@color/cam_accent_light"
        app:trackCornerRadius="3dp"
        app:trackStopIndicatorSize="0dp"
        app:trackThickness="@dimen/splash_progress_thickness" />

</androidx.constraintlayout.widget.ConstraintLayout>
