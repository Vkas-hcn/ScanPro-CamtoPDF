<?xml version="1.0" encoding="utf-8"?>
<!--
  常驻（前台服务）通知的大图版式：三个文件的快捷入口。
  出处：ApolloPDF `layout/notify_persistent_big.xml`。
  三个 `*Layout` 各自挂一个 PendingIntent（代码 `SpPersistentNotifyManager`）。
  29 以下代码会给 `root` 补上下 20dp 的 padding。

  注：`textColor` 只是白天的兜底值，实际颜色由代码按系统深浅色用 `setTextColor`
  盖一遍（`SpNotifyTheme`）——RemoteViews 不会自己跟着深色模式反色。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="88dp"
    android:baselineAligned="false"
    android:gravity="center">

    <LinearLayout
        android:id="@+id/pdfLayout"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_home_list_pdf" />

        <TextView
            android:id="@+id/tagPdf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sp_notify_tag_pdf"
            android:textColor="@color/sp_notify_text"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/excelLayout"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_home_list_xls" />

        <TextView
            android:id="@+id/tagExcel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sp_notify_tag_excel"
            android:textColor="@color/sp_notify_text"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/pptLayout"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_home_list_ppt" />

        <TextView
            android:id="@+id/tagPpt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sp_notify_tag_ppt"
            android:textColor="@color/sp_notify_text"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
