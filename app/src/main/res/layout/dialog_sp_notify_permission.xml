<?xml version="1.0" encoding="utf-8"?>
<!--
  通知权限二次引导框（对齐 SmartPdfScan_luow `flot_perm.xml` 的用途，版式用本项目弹窗样式）。
  只在「系统已经不再弹授权框」时由 `SpNotifyPermissionFlow` 弹出：
  图标 + 标题 + 说明 + 「Open settings」/「Not now」。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/cam_dialog_card"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="28dp"
    android:paddingBottom="20dp">

    <ImageView
        android:id="@+id/iv_icon"
        android:layout_width="112dp"
        android:layout_height="112dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_permission" />

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="@string/sp_notify_perm_title"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:text="@string/sp_notify_perm_message"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/btn_open_settings"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/cam_btn_primary"
        android:gravity="center"
        android:text="@string/sp_notify_perm_open_settings"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btn_not_now"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_btn_cancel"
        android:gravity="center"
        android:text="@string/sp_notify_perm_not_now"
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
