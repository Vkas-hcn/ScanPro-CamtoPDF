<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CamPdf" parent="Theme.Material3.Light.NoActionBar">
        <!-- Avoid black/dark flash when Activities recreate on locale change -->
        <item name="android:windowBackground">@drawable/bg</item>
        <item name="android:windowAnimationStyle">@style/CamWindow.NoFlash</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <style name="CamWindow.NoFlash" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/none</item>
        <item name="android:activityOpenExitAnimation">@anim/none</item>
        <item name="android:activityCloseEnterAnimation">@anim/none</item>
        <item name="android:activityCloseExitAnimation">@anim/none</item>
    </style>

    <style name="Theme.CamPdf.Dialog" parent="Theme.Material3.Light.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="SpRateSheetAnimation">
        <item name="android:windowEnterAnimation">@anim/slide_in_bottom</item>
        <item name="android:windowExitAnimation">@anim/slide_out_bottom</item>
    </style>

    <!-- 全屏广告前的假加载遮罩。Apollo `R.style.FullScreenLoadingDialog` 的等价。 -->
    <style name="SpFullScreenLoadingDialog" parent="Theme.CamPdf.Dialog">
        <item name="android:windowBackground">@color/white</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
