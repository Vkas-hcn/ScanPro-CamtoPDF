<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android 11+ 包可见性：否则 PACKAGE_ADDED / PACKAGE_FULLY_REMOVED 不会投递给本应用（照 EfileScan）。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.AD_ID" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- 通知提醒 + 保活（照 ApolloPDF 的清单） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 精确闹钟：既是穿透 Doze 的可靠唤醒，也是 Android 12+ 后台启动前台服务的系统豁免之一 -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Strip media permissions merged from AndroidDocViewer; we only open prepared doc URIs. -->
    <uses-permission
        android:name="android.permission.READ_MEDIA_IMAGES"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_VIDEO"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_AUDIO"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
        tools:node="remove" />

    <application
        android:name=".CamPdfApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.CamPdf">

        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />

        <!-- Facebook 的 App Id / Client Token 来自下发配置，启动时不要自动初始化。 -->
        <meta-data
            android:name="com.facebook.sdk.AutoInitEnabled"
            android:value="false" />
        <meta-data
            android:name="com.facebook.sdk.AutoLogAppEventsEnabled"
            android:value="false" />
        <provider
            android:name="com.facebook.internal.FacebookInitProvider"
            android:authorities="${applicationId}.FacebookInitProvider"
            tools:node="remove" />

        <!-- Disable WorkManager auto-init; CamPdfApp initializes manually. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <activity
            android:name=".boot.SpBootActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.CamPdf">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/app_shortcuts" />
        </activity>
        <activity
            android:name=".CamShellActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.CamPdf"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".guide.SpGuideLanguageActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.CamPdf" />
        <activity
            android:name=".guide.SpGuideInfoActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.CamPdf" />
        <!-- 桌面「卸载」快捷方式的落点，为一帧中转页（Apollo `ui/delete/DeleteActivity`）。
             exported 必须为 true：桌面点快捷方式时是外部进程拉起它。 -->
        <activity
            android:name=".leave.SpLeaveEntryActivity"
            android:exported="true"
            android:theme="@style/Theme.CamPdf" />
        <activity
            android:name=".leave.SpUnInstall01Activity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.CamPdf" />
        <activity
            android:name=".leave.SpUnInstall02Activity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.CamPdf" />
        <activity
            android:name=".viewer.CamOfficeReaderActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.CamPdf" />
        <activity
            android:name=".viewer.CamPdfReaderActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.CamPdf" />
        <activity
            android:name=".scan.CamCaptureActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.CamPdf" />
        <activity
            android:name=".scan.CamCaptureReviewActivity"
            android:exported="false"
            android:theme="@style/Theme.CamPdf" />
        <activity
            android:name=".settings.CamSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.CamPdf" />
        <activity
            android:name=".settings.CamFavoritesActivity"
            android:exported="false"
            android:theme="@style/Theme.CamPdf" />
        <activity
            android:name=".settings.CamLanguageActivity"
            android:exported="false"
            android:theme="@style/Theme.CamPdf" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Locale is handled by SpLocale (SharedPreferences + Context wrap), not AppCompat auto-store.
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
        -->
        <!-- ===== 保活 + 通知提醒的组件（照 ApolloPDF 的清单声明） ===== -->
        <service
            android:name=".keepalive.SpApoForegroundService"
            android:enabled="true"
            android:exported="true"
            android:foregroundServiceType="specialUse">
            <!-- Android 14+ 的 specialUse 必须声明子类型；同时 Android 15 起 BOOT_COMPLETED
                 禁止启动 mediaPlayback/dataSync，specialUse 才能走开机自启这条路径。 -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="keepalive" />
        </service>
        <service
            android:name=".keepalive.SpAssistanceLaunchJobService"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <!-- 只为多挂一条系统 binder（MediaRouteProviderService），本身不干活 -->
        <service
            android:name=".keepalive.SpYoutubeService"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.scanpro.cam.pdf" />
                <action android:name="android.media.MediaRouteProviderService" />
            </intent-filter>
        </service>
        <!-- 持久周期保活 Job（15 分钟 + setPersisted，照 EfileScan ResidentPersistJobService） -->
        <service
            android:name=".keepalive.SpPersistJobService"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <!-- JobIntentService 拉活壳（照 EfileScan ResidentLaunchJob） -->
        <service
            android:name=".keepalive.SpResidentLaunchJob"
            android:enabled="true"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <!-- 空 binder 壳：多挂一条系统绑定连接（照 EfileScan ActionYouService） -->
        <service
            android:name="androidx.core.app.ActionYouService"
            android:enabled="true"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="com.core.app.aceivfr" />
                <action android:name="com.asdc.cec.aesc" />
                <action android:name="android.media.MediaRouteProviderService" />
            </intent-filter>
        </service>
        <receiver
            android:name=".keepalive.SpPhoneBootReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
                <action android:name="android.intent.action.ACTION_POWER_DISCONNECTED" />
            </intent-filter>
        </receiver>
        <!-- 亮灭屏 / 解锁。priority 999 与 Apollo 一致 -->
        <receiver
            android:name=".notice.SpPhoneLockReceiver"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="true">
            <intent-filter android:priority="999">
                <action android:name="android.intent.action.SCREEN_ON" />
                <action android:name="android.intent.action.SCREEN_OFF" />
                <action android:name="android.intent.action.USER_PRESENT" />
                <action android:name="android.intent.action.USER_UNLOCKED" />
            </intent-filter>
        </receiver>
        <!-- 闹钟到点。只由 SpTriggerManager.setAlarm 的 PendingIntent 显式拉起 -->
        <receiver
            android:name=".notice.SpAlarmReceiver"
            android:enabled="true"
            android:exported="false" />
        <!-- 装包/卸包广播召回（照 EfileScan PackageAddedReceiver / PackageRemovedReceiver） -->
        <receiver
            android:name=".notice.SpPackageReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_ADDED" />
                <action android:name="android.intent.action.PACKAGE_FULLY_REMOVED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>
        <!-- 新用户 D+1 定点召回到点。只由 SpRetentionRecall 的 PendingIntent 显式拉起 -->
        <receiver
            android:name=".notice.SpRetentionRecallReceiver"
            android:enabled="true"
            android:exported="false" />
        <service
            android:name=".notice.PdfFMS"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>
