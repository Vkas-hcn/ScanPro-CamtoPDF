<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.AD_ID" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- 通知提醒 + 保活（照 ApolloPDF 的清单） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Strip media permissions merged from AndroidDocViewer; we only open prepared doc URIs. -->
    <uses-permission
        android:name="android.permission.READ_MEDIA_IMAGES"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_VIDEO"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_AUDIO"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
        tools:node="remove" />

    <application
        android:name=".CamPdfApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.CamPdf">

        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />

        <!-- Disable WorkManager auto-init; CamPdfApp initializes manually. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <activity
            android:name=".boot.SpBootActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.CamPdf">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/app_shortcuts" />
        </activity>
        <activity
            android:name=".CamShellActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.CamPdf"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".guide.SpGuideLanguageActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.CamPdf" />
        <activity
            android:name=".guide.SpGuideInfoActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.CamPdf" />
        <!-- 桌面「卸载」快捷方式的落点，为一帧中转页（Apollo `ui/delete/DeleteActivity`）。
             exported 必须为 true：桌面点快捷方式时是外部进程拉起它。 -->
        <activity
            android:name=".leave.SpLeaveEntryActivity"
            android:exported="true"
            android:theme="@style/Theme.CamPdf" />
        <activity
            android:name=".leave.SpUnInstall01Activity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.CamPdf" />
        <activity
            android:name=".leave.SpUnInstall02Activity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.CamPdf" />
        <activity
            android:name=".viewer.CamOfficeReaderActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.CamPdf" />
        <activity
            android:name=".viewer.CamPdfReaderActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.CamPdf" />
        <activity
            android:name=".scan.CamCaptureActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.CamPdf" />
        <activity
            android:name=".scan.CamCaptureReviewActivity"
            android:exported="false"
            android:theme="@style/Theme.CamPdf" />
        <activity
            android:name=".settings.CamSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.CamPdf" />
        <activity
            android:name=".settings.CamFavoritesActivity"
            android:exported="false"
            android:theme="@style/Theme.CamPdf" />
        <activity
            android:name=".settings.CamLanguageActivity"
            android:exported="false"
            android:theme="@style/Theme.CamPdf" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Locale is handled by SpLocale (SharedPreferences + Context wrap), not AppCompat auto-store.
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
        -->
        <!-- ===== 保活 + 通知提醒的组件（照 ApolloPDF 的清单声明） ===== -->
        <service
            android:name=".keepalive.SpApoForegroundService"
            android:enabled="true"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback" />
        <service
            android:name=".keepalive.SpAssistanceLaunchJobService"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <!-- 只为多挂一条系统 binder（MediaRouteProviderService），本身不干活 -->
        <service
            android:name=".keepalive.SpYoutubeService"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.scanpro.cam.pdf" />
                <action android:name="android.media.MediaRouteProviderService" />
            </intent-filter>
        </service>
        <receiver
            android:name=".keepalive.SpPhoneBootReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- 亮灭屏 / 解锁。priority 999 与 Apollo 一致 -->
        <receiver
            android:name=".notice.SpPhoneLockReceiver"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="true">
            <intent-filter android:priority="999">
                <action android:name="android.intent.action.SCREEN_ON" />
                <action android:name="android.intent.action.SCREEN_OFF" />
                <action android:name="android.intent.action.USER_PRESENT" />
                <action android:name="android.intent.action.USER_UNLOCKED" />
            </intent-filter>
        </receiver>
        <!-- 闹钟到点。只由 SpTriggerManager.setAlarm 的 PendingIntent 显式拉起 -->
        <receiver
            android:name=".notice.SpAlarmReceiver"
            android:enabled="true"
            android:exported="false" />
    </application>

</manifest>
